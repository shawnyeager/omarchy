#!/bin/bash

# omarchy:summary=Update AUR packages if any are installed

# yay's credential loop calls sudo -v. Under the default verifypw=all that
# prompts again even when this update's timestamp is still valid. The update
# keepalive refreshes that timestamp, so leave yay's loop off.
if pacman -Qem >/dev/null; then
  if omarchy-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate AUR packages\e[0m"
    yay --sudoloop=false -Sua --noconfirm --cleanafter --ignore gcc14,gcc14-libs || exit 1
    echo
  else
    echo -e "\e[31m\nAUR is unavailable (so skipping updates)\e[0m"
    echo
  fi
fi
